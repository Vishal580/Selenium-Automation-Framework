# Email Configuration
# Copy this file to .env and update with your actual values

# SMTP Server Configuration
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587

# Email Credentials
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Recipients (comma-separated if multiple recipients)
EMAIL_TO=recipient@example.com,another@example.com

# Notes:
# - For Gmail: Create an App Password in your Google Account settings
# - For other email providers: Use your email provider's SMTP server and credentials
# - The .env file should NOT be committed to version control (add to .gitignore)
